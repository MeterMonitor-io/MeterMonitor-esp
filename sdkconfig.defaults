# General settings
CONFIG_PM_ENABLE=y
#CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_ESP32_DEEP_SLEEP_WAKEUP_DELAY=0
CONFIG_ESP32_RTC_CLOCK_SOURCE_EXTERNAL_CRYSTAL=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_80=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_MHZ=80
CONFIG_FREERTOS_UNICORE=y
CONFIG_FREERTOS_HZ=100
CONFIG_ESP32_DISABLE_BASIC_ROM_CONSOLE=y
CONFIG_BT_ENABLED=n
CONFIG_ESP32_SPIRAM_SUPPORT=n
CONFIG_ESP32_RTC_CLOCK_SOURCE_INTERNAL_RC=y
CONFIG_ESP32_COREDUMP_ENABLE=n
CONFIG_ESP32_DEBUG_OCDAWARE=n
CONFIG_TASK_WDT=n
CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# WaterMeter - Application specific settings
CONFIG_WATER_METER_SLEEP_TIME=10
CONFIG_WATER_METER_WIFI_SSID="TODO"
CONFIG_WATER_METER_WIFI_PASSWORD="TODO"
CONFIG_WATER_METER_WIFI_MAXIMUM_RETRY=5
CONFIG_WATER_METER_MQTT_URI="mqtt://192.168.2.136"
CONFIG_WATER_METER_MQTT_PORT=1883
CONFIG_WATER_METER_MQTT_TOPIC="WaterMeter/01/"
CONFIG_WATER_METER_MQTT_USERNAME="mqtt"
CONFIG_WATER_METER_MQTT_PASSWORD="mqtt"
